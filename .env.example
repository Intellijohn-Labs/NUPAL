# ── Database: Supabase (Project → Connect → ORMs → Prisma) ──────────────────────────
# Transaction pooler (port 6543), used by the app. Keep ?pgbouncer=true and &schema=nupal.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=nupal"
# Session pooler (port 5432), used to create and update tables.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=nupal"
# schema=nupal keeps the shop’s tables out of Supabase’s public Data API.

# ── Image storage: Supabase Storage (Project Settings → API) ────────────────────────
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Secret server-side key. Never expose it in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="nupal"

# ── Admin login ─────────────────────────────────────────────────────────────────────
# Long random string used to sign admin sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# First admin account created by `npm run db:seed`. Change the password after the first login.
SEED_ADMIN_EMAIL="admin@nupalremedies.com"
SEED_ADMIN_PASSWORD="ChangeMe@123"

# Public site URL, used in links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
